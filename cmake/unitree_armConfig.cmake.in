@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# unitree_arm's public headers include unitree/dds_wrapper/... and its target
# links unitree_sdk2, so the SDK must be found before our targets file.
list(APPEND CMAKE_PREFIX_PATH "/opt/unitree_robotics/lib/cmake")
find_dependency(unitree_sdk2 REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/unitree_armTargets.cmake")

check_required_components(unitree_arm)
